    <!-- Tutorials -->
    <string name="tut_ok">Got it</string>
    <string name="tut_swap_title">Swap to match</string>
    <string name="tut_swap">Drag a piece onto a neighbour to swap them. Line up 3 or more of the same kind to clear them.</string>
    <string name="tut_ray_title">Ray</string>
    <string name="tut_ray">Match 4 in a line to make a Ray. Use it to clear a whole row or column.</string>
    <string name="tut_jelly_title">Jellyfish</string>
    <string name="tut_jelly">Match 5 in an L or T shape to make a Jellyfish. It explodes twice around itself.</string>
    <string name="tut_fish_title">Lanternfish</string>
    <string name="tut_fish">Match a 2×2 square to make a Lanternfish. It swims to a piece that helps your goal.</string>
    <string name="tut_pearl_title">Abyss Pearl</string>
    <string name="tut_pearl">Match 5 in a line to make an Abyss Pearl. Swap it with a piece to clear every piece of that colour.</string>
    <string name="tut_combo_title">Combos</string>
    <string name="tut_combo">Swap two specials together for a much bigger effect.</string>
    <string name="tut_barnacle_title">Barnacles</string>
    <string name="tut_barnacle">Barnacles hold a piece in place. Match it or next to it to break a layer.</string>
    <string name="tut_silt_title">Silt</string>
    <string name="tut_silt">Silt lies under pieces. Match on top of it to clear it.</string>
    <string name="tut_lanterns_title">Lanterns</string>
    <string name="tut_lanterns">Bring the lanterns down to the exit at the bottom by clearing pieces under them.</string>
    <string name="tut_coral_title">Coral</string>
    <string name="tut_coral">Coral blocks a cell. Match next to it or hit it with a special to break it.</string>
    <string name="tut_net_title">Nets</string>
    <string name="tut_net">A netted piece cannot move, but it still matches. Matching it breaks the net.</string>
    <string name="tut_oil_title">Oil slick</string>
    <string name="tut_oil">Oil spreads after every move in which you destroy none. Match next to it to clean it.</string>
    <string name="tut_seahorse_title">Seahorses</string>
    <string name="tut_seahorse">Match next to a bubble to pop it and free the seahorse inside.</string>
    <string name="tut_conveyor_title">Currents</string>
    <string name="tut_conveyor">Currents move the pieces on them one step after every move.</string>
    <string name="tut_glow_title">Glow</string>
    <string name="tut_glow">Matches that touch a glowing cell spread the light. Light up the whole board.</string>
    <string name="tut_oyster_title">Giant oyster</string>
    <string name="tut_oyster">Match its colour next to the oyster, or hit it with specials, until it opens.</string>
    <string name="tut_sinkhole_title">Sinkhole</string>
    <string name="tut_sinkhole">The sinkhole swallows a piece every 2 moves. Only specials can close it.</string>
    <string name="tut_octopus_title">Octopus</string>
    <string name="tut_octopus">Every 3 moves the octopus throws nets. Match next to it to drive it away.</string>
