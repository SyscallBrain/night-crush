    <!-- Tutorials -->
    <string name="tut_ok">Percebi</string>
    <string name="tut_swap_title">Troca para combinar</string>
    <string name="tut_swap">Arrasta uma peça para a vizinha para as trocar. Alinha 3 ou mais iguais para as limpar.</string>
    <string name="tut_ray_title">Raia</string>
    <string name="tut_ray">Combina 4 em linha para criar uma Raia. Usa-a para limpar uma linha ou coluna inteira.</string>
    <string name="tut_jelly_title">Alforreca</string>
    <string name="tut_jelly">Combina 5 em L ou em T para criar uma Alforreca. Explode duas vezes à sua volta.</string>
    <string name="tut_fish_title">Peixe-lanterna</string>
    <string name="tut_fish">Combina um quadrado 2×2 para criar um Peixe-lanterna. Nada até uma peça que ajude o teu objetivo.</string>
    <string name="tut_pearl_title">Pérola Abissal</string>
    <string name="tut_pearl">Combina 5 em linha para criar uma Pérola Abissal. Troca-a com uma peça para limpar todas dessa cor.</string>
    <string name="tut_combo_title">Combinações</string>
    <string name="tut_combo">Troca dois especiais entre si para um efeito muito maior.</string>
    <string name="tut_barnacle_title">Cracas</string>
    <string name="tut_barnacle">As cracas prendem uma peça. Combina-a ou combina ao lado para partir uma camada.</string>
    <string name="tut_silt_title">Lodo</string>
    <string name="tut_silt">O lodo está por baixo das peças. Combina por cima dele para o limpar.</string>
    <string name="tut_lanterns_title">Lanternas</string>
    <string name="tut_lanterns">Leva as lanternas até à saída lá em baixo, limpando as peças por baixo delas.</string>
    <string name="tut_coral_title">Coral</string>
    <string name="tut_coral">O coral ocupa uma casa. Combina ao lado ou usa um especial para o partir.</string>
    <string name="tut_net_title">Redes</string>
    <string name="tut_net">Uma peça com rede não se mexe, mas combina. Ao combiná-la, a rede parte-se.</string>
    <string name="tut_oil_title">Maré negra</string>
    <string name="tut_oil">A maré negra cresce depois de cada jogada em que não destruas nenhuma. Combina ao lado para a limpar.</string>
    <string name="tut_seahorse_title">Cavalos-marinhos</string>
    <string name="tut_seahorse">Combina ao lado de uma bolha para a rebentar e libertar o cavalo-marinho.</string>
    <string name="tut_conveyor_title">Corrente marítima</string>
    <string name="tut_conveyor">A corrente avança as peças que estão nela uma casa depois de cada jogada.</string>
    <string name="tut_glow_title">Bioluminescência</string>
    <string name="tut_glow">Combinações que tocam numa casa acesa espalham a luz. Acende o tabuleiro todo.</string>
    <string name="tut_oyster_title">Ostra gigante</string>
    <string name="tut_oyster">Combina a cor da ostra ao lado dela, ou atinge-a com especiais, até ela abrir.</string>
    <string name="tut_sinkhole_title">Sorvedouro</string>
    <string name="tut_sinkhole">O sorvedouro engole uma peça a cada 2 jogadas. Só os especiais o fecham.</string>
    <string name="tut_octopus_title">Polvo</string>
    <string name="tut_octopus">A cada 3 jogadas o polvo lança redes. Combina ao lado dele para o afastar.</string>
